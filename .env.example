# Copy to .env and adjust for local dev. Never commit the real .env.
#
# Read only by `make dev`/`make dev-down`/`make dev-logs`/`make migrate`
# (infra/docker-compose.yml via `--env-file .env`). The app, Alembic, and
# pytest read DATABASE_URL straight from the process environment and never
# load this file — see README "Local setup" for how to set DATABASE_URL
# for those.

# Deliberately not DATABASE_URL: a shell that already exports DATABASE_URL
# for a non-Docker command (e.g. against a disposable *_test database) must
# never leak into the Docker Compose stack's containers.
HELIOS_COMPOSE_DATABASE_URL=postgresql+psycopg://helios:helios@postgres:5432/helios

# docker-compose reads these to configure the postgres service itself.
POSTGRES_USER=helios
POSTGRES_PASSWORD=helios
POSTGRES_DB=helios
