# The batch loop on the Pi under systemd (ADR-0030 Q2): manual starts only, so there is no
# [Install] section and the unit cannot be enabled at boot. A timer comes with Phase 6.
#   sudo cp infra/pipeline-host/helios-pipeline-loop.service /etc/systemd/system/
#   cp infra/pipeline-host/loop.env.example var/pipeline-host/loop.env   # then edit LOOP_ARGS
#   sudo systemctl daemon-reload
#   sudo systemctl start helios-pipeline-loop      # journalctl -u helios-pipeline-loop -f
# Stop between batches with `touch var/pipeline-host/STOP` (the loop logs "loop end").
# `systemctl stop` stops mid-batch, which loses no data (both CLIs commit per URL or page and
# the next run takes the rest), but check `docker ps` afterwards for a worker container left
# running (not tested on the Pi yet).
[Unit]
Description=Helios pipeline batch loop (ADR-0030; manual starts only)
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=simple
User=orangepi
WorkingDirectory=/home/orangepi/First-Helios
EnvironmentFile=/home/orangepi/First-Helios/var/pipeline-host/loop.env
# $LOOP_ARGS unbraced: systemd splits it into words
ExecStart=/usr/bin/python3 -m apps.menu_pipeline.batch_loop $LOOP_ARGS
Restart=no
TimeoutStopSec=120
