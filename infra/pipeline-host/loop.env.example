# var/pipeline-host/loop.env: the batch loop's arguments for helios-pipeline-loop.service.
# Phase 6 monthly runs (ADR-0030 Amendment 1): run to the end of the due URLs, one gate per run;
# model pages on the laptop GPU over the LAN (ADR-0030 Q3):
LOOP_ARGS=--host pi --phase full --db helios_work --batch 50 --stop-every 0 --server http://192.168.1.183:8083
# A long recrawl with a swap every 10 batches instead: --stop-every 10.
# Model pages on the Pi's own CPU llama-server instead: drop --server.
# Re-interpretation only, from saved answers: --host pi --phase extract-no-model --db helios_work
