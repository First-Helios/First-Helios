# ~/.config/helios-ops/r2.env on the Pi: mode 0600, in a directory of mode 0700 (ADR-0031 D1).
# Read by helios-backup.service. Never in the repo, the deploy directory, the image, a container
# or a log. Values: the owner's R2 API token, scoped to the one bucket, Object Read & Write (the
# dashboard shows its S3 access key pair once, at creation).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# R2 has one region, "auto".
AWS_DEFAULT_REGION=auto
# s3:https://<account id>.r2.cloudflarestorage.com/<bucket>
RESTIC_REPOSITORY=s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/helios-backups
