# ~/.config/helios-ops/hc.env on the Pi: mode 0600, in a directory of mode 0700 (ADR-0031 D5).
# The healthchecks.io ping URL of each check (https://hc-ping.com/<uuid>). Anyone holding one can
# send a false "all well", so they are kept like the other secrets: never in the repo, the
# deploy directory, the image, a container or a log. An empty value means that check isn't pinged.
# helios-watch.service (infra/ops/watch.sh):
HC_SITE_URL=
HC_DISK_URL=
HC_RUN_PROGRESS_URL=
HC_AWAITING_READER_URL=
# helios-pipeline-loop.service (ExecStartPre= /start, ExecStopPost= /$EXIT_STATUS):
HC_MONTHLY_RUN_URL=
# helios-backup.service (infra/backup/backup.sh, ADR-0031 D1):
HC_BACKUP_URL=
